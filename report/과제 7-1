9. 다음 프로그램은 val1에서 val2를 빼기 위한 것이다. 모든 논리 오류를 찾아 수정하시오. 
(CLC는 캐리 플래그를 0으로 만든다.)
.data
val1   QWORD 20403004362047A1h
val2   QWORD 055210304A2630B2h
result QWORD 0

.code
    mov cx,8                 ; 반복 횟수
    mov esi,val1             ; 인덱스를 시작 위치로 설정
    mov edi,val2
    clc                      ; 캐리 플래그를 0으로 설정
top:
    mov al,BYTE PTR [esi]    ; 첫 번째 수의 바이트를 읽음
    sbb al,BYTE PTR [edi]    ; 두 번째 수의 바이트를 뺌
    mov BYTE PTR [esi],al    ; 결과를 저장
    dec esi
    dec edi
    loop top

.data
val1   QWORD 20403004362047A1h
val2   QWORD 055210304A2630B2h
result QWORD 0

.code
    mov ecx,8
    mov esi,OFFSET val1
    mov edi,OFFSET val2
    mov ebx,OFFSET result
    clc
top:
    mov al,BYTE PTR [esi]
    sbb al,BYTE PTR [edi]
    mov BYTE PTR [ebx],al
    inc esi
    inc edi
    inc ebx
    loop top



