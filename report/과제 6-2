6.11.1 Suggestions for Testing Your Code (코드 테스트를 위한 제안 사항)
이 절은 조건문과 분기문이 포함된 어셈블리 프로그램을 디버깅하고 검증할 때 필요한 핵심 테스트 지침을 설명합니다.
 * 모든 조건 분기 테스트 (Test All Conditional Branches)
   * 조건 점프(Jcond) 및 IF-THEN-ELSE 구조에 포함된 모든 실행 경로(참인 경우와 거짓인 경우)가 최소 한 번 이상 
    실행되도록 테스트 데이터를 구성합니다.
 * 경계값 테스트 (Test Boundary Cases)
   * 조건 비교의 경계에 위치한 값(범위의 최솟값, 최댓값, 기준 임계값, 0, 음수 등)을 입력값으로 사용하여 부등호 오차(off-by-one 오류)나
    부호 불일치 오류가 없는지 확인합니다.
 * 유효하지 않은 입력값 처리 (Test Invalid Inputs)
   * 프로그램에 지정된 범위를 벗어난 비정상적인 데이터가 입력되었을 때 예외가 발생하거나 비정상 종료되지 않고 적절히 필터링되는지 검증합니다.
 * 디버거를 통한 상태 플래그 확인 (Inspect CPU Status Flags)
   * Visual Studio 디버거의 단축키(F10 프로시저 단위 실행, F11 한 단계씩 코드 실행)를 활용하여 CMP, TEST 등의 명령어 실행 직후 상태 
    플래그(ZF, SF, CF, OF)가 의도한 대로 바뀌는지 레지스터 창에서 직접 추적합니다.
 * 모듈식 단위 테스트 (Modular Testing)
   * 전체 코드를 한꺼번에 실행하지 말고, 개별 서브루틴(프로시저) 단위로 테스트를 진행하여 입력값에 따른 출력 및 반환값이 올바른지 확인한 후 전체 프로그램을 결합합니다.


6.11.2 Exercise Descriptions

1. 배열 채우기 (Filling an Array)
정수 배열을 지정된 범위 [j .. k] 사이의 의사 난수(pseudo-random)로 채우는 프로시저를 작성하시오. 
배열의 오프셋, 배열의 크기, j, k 값은 레지스터나 파라미터로 전달받습니다.


INCLUDE Irvine32.inc

.code
;---------------------------------------------------------
; FillArray
; ESI: 배열 오프셋, ECX: 배열 크기, EAX: j (최솟값), EBX: k (최댓값)
;---------------------------------------------------------
FillArray PROC USES eax ebx ecx edx esi
    sub ebx, eax
    inc ebx            ; EBX = (k - j + 1)
    mov edx, eax       ; EDX = j
L1:
    mov eax, ebx
    call RandomRange   ; EAX = 0 ~ (k - j)
    add eax, edx       ; EAX = j ~ k
    mov [esi], eax
    add esi, TYPE DWORD
    loop L1
    ret
FillArray ENDP


2. 범위 내 배열 원소 합산 (Summing Array Elements in a Range)
32비트 부호 있는 정수 배열을 순회하며, 값이 j 이상 k 이하인 원소들의 합만을 계산하여 반환하는 프로시저를 작성하시오.

INCLUDE Irvine32.inc

.code
;---------------------------------------------------------
; SumRange
; ESI: 배열 오프셋, ECX: 원소 수, EAX: j (최솟값), EDX: k (최댓값)
; 반환: EAX = 합계
;---------------------------------------------------------
SumRange PROC USES ebx ecx edx esi
    mov ebx, eax       ; EBX = j
    mov eax, 0         ; EAX = 합계 누적기
L1:
    mov edi, [esi]
    cmp edi, ebx
    jl  Next           ; 원소 < j 이면 제외
    cmp edi, edx
    jg  Next           ; 원소 > k 이면 제외
    add eax, edi       ; j <= 원소 <= k 이면 합산
Next:
    add esi, 4
    loop L1
    ret
SumRange ENDP


3. 시험 점수 평가 (Test Score Evaluation)
50부터 100 사이의 난수 점수 10개를 생성하고, 각 점수를 다음 기준에 따라 학점으로 변환하여 출력하시오.
(90100: 'A', 8089: 'B', 7079: 'C', 6069: 'D', 50~59: 'F')

INCLUDE Irvine32.inc

.data
scoreMsg BYTE "점수: ",0
gradeMsg BYTE "  학점: ",0

.code
main PROC
    call Randomize
    mov ecx, 10
L1:
    mov eax, 51
    call RandomRange
    add eax, 50            ; 50 ~ 100 사이 난수

    mov edx, OFFSET scoreMsg
    call WriteString
    call WriteDec

    mov edx, OFFSET gradeMsg
    call WriteString
    call CalcGrade
    call WriteChar
    call Crlf
    loop L1

    exit
main ENDP

CalcGrade PROC
    cmp eax, 90
    jl  GradeB
    mov al, 'A'
    ret
GradeB:
    cmp eax, 80
    jl  GradeC
    mov al, 'B'
    ret
GradeC:
    cmp eax, 70
    jl  GradeD
    mov al, 'C'
    ret
GradeD:
    cmp eax, 60
    jl  GradeF
    mov al, 'D'
    ret
GradeF:
    mov al, 'F'
    ret
CalcGrade ENDP
END main


4. 대학 수강 등록 (College Registration)
학생의 학점 수(Credits)와 평점(GPA)을 비교하여 등록 가능 여부를 판단하는 프로그램을 작성하시오.
 * 정답:
INCLUDE Irvine32.inc

.data
gradePointAverage DWORD 275    ; GPA * 100 (예: 2.75 -> 275)
creditHours       DWORD 15
okMsg             BYTE "수강 등록이 승인되었습니다.", 0
failMsg           BYTE "수강 등록이 불가합니다.", 0

.code
main PROC
    ; 규칙: 학점이 1~12학점이고 GPA가 2.0(200) 이상이거나,
    ; 13~19학점이고 GPA가 2.5(250) 이상인 경우 등
    cmp creditHours, 12
    ja  CheckMoreCredits
    cmp gradePointAverage, 200
    jge CanRegister
    jmp CannotRegister

CheckMoreCredits:
    cmp creditHours, 19
    ja  CannotRegister
    cmp gradePointAverage, 250
    jge CanRegister

CannotRegister:
    mov edx, OFFSET failMsg
    call WriteString
    call Crlf
    jmp Done

CanRegister:
    mov edx, OFFSET okMsg
    call WriteString
    call Crlf

Done:
    exit
main ENDP
END main


5. 부울 계산기 (Boolean Calculator)
사용자에게 메뉴를 보여주고 정수 두 개에 대해 AND, OR, NOT, XOR 연산을 수행한 후 결과를 16진수로 출력하는 프로그램을 작성하시오.

INCLUDE Irvine32.inc

.data
menu BYTE "1. x AND y", 0dh, 0ah
     BYTE "2. x OR y", 0dh, 0ah
     BYTE "3. NOT x", 0dh, 0ah
     BYTE "4. x XOR y", 0dh, 0ah
     BYTE "5. 종료", 0dh, 0ah
     BYTE "선택: ", 0
msgX BYTE "x 입력(16진수): ", 0
msgY BYTE "y 입력(16진수): ", 0
msgR BYTE "결과: ", 0

.code
main PROC
MenuLoop:
    mov edx, OFFSET menu
    call WriteString
    call ReadInt
    cmp eax, 5
    je  Quit
    cmp eax, 1
    je  DoAND
    cmp eax, 2
    je  DoOR
    cmp eax, 3
    je  DoNOT
    cmp eax, 4
    je  DoXOR
    jmp MenuLoop

DoAND:
    call InputXY
    and eax, ebx
    call DisplayResult
    jmp MenuLoop

DoOR:
    call InputXY
    or  eax, ebx
    call DisplayResult
    jmp MenuLoop

DoNOT:
    mov edx, OFFSET msgX
    call WriteString
    call ReadHex
    not eax
    call DisplayResult
    jmp MenuLoop

DoXOR:
    call InputXY
    xor eax, ebx
    call DisplayResult
    jmp MenuLoop

Quit:
    exit
main ENDP

InputXY PROC
    mov edx, OFFSET msgX
    call WriteString
    call ReadHex
    mov ebx, eax
    mov edx, OFFSET msgY
    call WriteString
    call ReadHex
    xchg eax, ebx
    ret
InputXY ENDP

DisplayResult PROC
    mov edx, OFFSET msgR
    call WriteString
    call WriteHex
    call Crlf
    call Crlf
    ret
DisplayResult ENDP
END main


6. 부울 계산기 확장 (Boolean Calculator - Continued)
5번 문제를 테이블 기반 선택(Table-Driven Selection) 방식을 적용하여 다시 작성하시오.

INCLUDE Irvine32.inc

.data
CaseTable BYTE '1'
          DWORD ProcessAND
          BYTE '2'
          DWORD ProcessOR
          BYTE '3'
          DWORD ProcessNOT
          BYTE '4'
          DWORD ProcessXOR
NumberOfEntries = 4

.code
; 테이블 조회 루틴
ExecuteMenuOption PROC
    mov esi, OFFSET CaseTable
    mov ecx, NumberOfEntries
L1:
    cmp al, [esi]
    jne NextCase
    call NEAR PTR [esi+1]
    jmp EndTable
NextCase:
    add esi, 5
    loop L1
EndTable:
    ret
ExecuteMenuOption ENDP

ProcessAND PROC
    ; AND 연산 로직
    ret
ProcessAND ENDP

ProcessOR PROC
    ; OR 연산 로직
    ret
ProcessOR ENDP

ProcessNOT PROC
    ; NOT 연산 로직
    ret
ProcessNOT ENDP

ProcessXOR PROC
    ; XOR 연산 로직
    ret
ProcessXOR ENDP


7. 소수 판별 (Probable Prime)
입력된 양의 정수 N이 소수인지 여부를 판별하여, 소수이면 캐리 플래그(CF)를 지우고(0) 소수가 아니면 설정(1)하는 프로시저 IsPrime을 작성하시오.

INCLUDE Irvine32.inc

.code
;---------------------------------------------------------
; IsPrime
; 입력: EAX = 검사할 정수
; 반환: CF = 0 (소수), CF = 1 (합성수 또는 1 이하)
;---------------------------------------------------------
IsPrime PROC USES ebx ecx edx
    cmp eax, 2
    jl  NotPrime
    je  Prime
    test eax, 1
    jz  NotPrime       ; 2를 제외한 짝수는 소수가 아님

    mov ecx, eax
    mov ebx, 3         ; 3부터 나누기 시작
CheckLoop:
    mov eax, ebx
    mul eax            ; EAX = ebx * ebx
    cmp eax, ecx
    ja  Prime          ; divisor^2 > n 이면 소수

    mov eax, ecx
    mov edx, 0
    div ebx
    cmp edx, 0
    jz  NotPrime       ; 나머지가 0이면 합성수

    add ebx, 2
    jmp CheckLoop

Prime:
    clc                ; CF = 0
    ret
NotPrime:
    stc                ; CF = 1
    ret
IsPrime ENDP


8. 소수 개수 세기 (Counting Primes)
2부터 1000 사이의 모든 소수를 찾아 출력하고, 그 총 개수를 화면에 표시하는 프로그램을 작성하시오.

INCLUDE Irvine32.inc

.data
primeCount DWORD 0
countMsg   BYTE "발견된 소수의 개수: ", 0

.code
main PROC
    mov esi, 2
FindPrimes:
    mov eax, esi
    call IsPrime       ; 7번 문제의 IsPrime 프로시저 호출
    jc  NextNum
    call WriteDec
    mov al, ' '
    call WriteChar
    inc primeCount
NextNum:
    inc esi
    cmp esi, 1000
    jbe FindPrimes

    call Crlf
    mov edx, OFFSET countMsg
    call WriteString
    mov eax, primeCount
    call WriteDec
    call Crlf
    exit
main ENDP
END main


9. PIN 번호 유효성 검사 (PIN Number Validation)
5자리 숫자로 구성된 PIN 번호가 사전에 정의된 각 자릿수별 범위 규칙에 맞는지 검사하여 유효 여부를 반환하는 프로시저를 작성하시오.

INCLUDE Irvine32.inc

.data
minRange BYTE 5, 2, 4, 1, 3
maxRange BYTE 9, 5, 8, 4, 6

.code
;---------------------------------------------------------
; ValidatePIN
; ESI: 5바이트 배열 오프셋
; 반환: EAX = 0 (유효), EAX = 1 (유효하지 않음)
;---------------------------------------------------------
ValidatePIN PROC USES ecx edx esi
    mov ecx, 5
    mov edx, 0
ValLoop:
    mov al, [esi]
    cmp al, minRange[edx]
    jb  Invalid
    cmp al, maxRange[edx]
    ja  Invalid
    inc esi
    inc edx
    loop ValLoop

    mov eax, 0         ; 유효함
    ret
Invalid:
    mov eax, 1         ; 유효하지 않음
    ret
ValidatePIN ENDP

10. 패리티 검사 (Parity Checking)
바이트 배열을 순회하여 모든 바이트의 패리티를 확인하고, 홀수 패리티를 갖는 바이트가 포함되어 있는지 검사하는 프로그램을 작성하시오.

INCLUDE Irvine32.inc

.code
;---------------------------------------------------------
; CheckEvenParity
; ESI: 바이트 배열 포인터, ECX: 원소 개수
; 반환: AL = 1 (모두 짝수 패리티), AL = 0 (홀수 패리티 존재)
;---------------------------------------------------------
CheckEvenParity PROC USES ecx esi
ParityLoop:
    mov al, [esi]
    test al, 0FFh      ; Parity 플래그 설정
    jpo FoundOdd       ; 패리티가 홀수(Odd)이면 분기
    inc esi
    loop ParityLoop

    mov al, 1          ; 모든 바이트가 짝수 패리티
    ret
FoundOdd:
    mov al, 0          ; 홀수 패리티 발견
    ret
CheckEvenParity ENDP

